# Argus Service Environment Configuration

# Server Port
PORT=8080

# SQLite Persistence Path
ARGUS_DB_PATH=argus.db

# Ollama LLM Endpoint & Model
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b


# Slack Integration (Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# GitHub Integration (Personal Access Token / Fine-grained token)
GITHUB_TOKEN=ghp_your_github_token

# LaunchDarkly Integration (SDK or API Token)
LAUNCHDARKLY_TOKEN=sdk-your-launchdarkly-token

# Jira Integration
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_TOKEN=your-jira-api-token
